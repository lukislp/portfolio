# Response headers for Cloudflare Pages. This replaces the `header` block the Caddy reverse
# proxy used to add on the VPS, plus a few headers Caddy did not set.
#
# Note on the CSP: index.html uses an inline <style> block, an inline <script> block and a
# handful of inline `onclick=` attributes, so script-src cannot drop 'unsafe-inline' without
# rewriting the page first (nonces and hashes do not cover inline event handlers). Everything
# else is locked down: no external origins, no framing, no form submission, no plugins.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Fingerprinted assets are not used here, so keep the cache short enough that a content fix is
# visible quickly, and let the CDN revalidate rather than serve a stale page.
# Pages serves HTML pages without the .html extension and redirects the extension away, so these
# rules have to name the served paths - a "/*.html" pattern would match none of them.
/
  Cache-Control: public, max-age=300, must-revalidate

/impressum
  Cache-Control: public, max-age=300, must-revalidate

/en
  Cache-Control: public, max-age=300, must-revalidate

/404.html
  Cache-Control: public, max-age=300, must-revalidate

/og-image.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
